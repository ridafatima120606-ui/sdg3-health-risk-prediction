.vscode/
.idea/
*.suo
*.user
*.swp
*~

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Streamlit local cache
.streamlit/secrets.toml

# Build / distribution
dist/
build/
*.egg-info/

# Logs and temporary files
*.log
*.tmp
