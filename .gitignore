# Virtual environments
venv/
env/
.env/
.venv/
ENV/

# Trained model artifacts — generated by train_model.py
# Commit these ONLY if they are small enough (< 50 MB each)
# and you want Streamlit Cloud to load them without retraining.
# For this project we DO commit them (they are small).
# If you want to exclude them, uncomment the lines below:
# artifacts/model.pkl
# artifacts/scaler.pkl
# artifacts/metrics.pkl

